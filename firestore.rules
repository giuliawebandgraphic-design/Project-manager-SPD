rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isStudioAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "sagepaperdesign@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Projects Collection (allows read for studio admin or client viewing their project)
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (
        isStudioAdmin() ||
        isSignedIn() ||
        resource.data.status != null
      );
      allow list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow get, list: if isValidId(taskId) || isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Inventory Collection
    match /inventory/{inventoryId} {
      allow get, list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Supplier Orders Collection
    match /supplier_orders/{orderId} {
      allow get, list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Call Notes Collection
    match /call_notes/{callNoteId} {
      allow get, list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow get, list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Studio Expenses Collection
    match /studio_expenses/{expenseId} {
      allow get, list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Client Emails Collection
    match /client_emails/{emailId} {
      allow get, list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow get, list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Catalog Products Collection
    match /catalog_products/{productId} {
      allow get, list: if isValidId(productId) || isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      allow get: if isValidId(quoteId);
      allow list: if isStudioAdmin() || isSignedIn();
      allow create, update, delete: if isStudioAdmin() || isSignedIn();
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
